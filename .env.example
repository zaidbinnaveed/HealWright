# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- HealWright settings (defaults shown) ---
HEALWRIGHT_MODE=heal                 # off | record | heal
HEALWRIGHT_PROBE_TIMEOUT_MS=3000
HEALWRIGHT_TAU_CONF=0.70
HEALWRIGHT_DELTA_MARGIN=0.06
HEALWRIGHT_TIER2_FLOOR=0.35
HEALWRIGHT_MAX_HEALS_PER_TEST=3
HEALWRIGHT_HEAL_DEADLINE_S=30
HEALWRIGHT_VLM_MODE=record           # live | record | replay
HEALWRIGHT_VLM_RUN_CAP=30
HEALWRIGHT_PROVIDERS=groq,mistral
HEALWRIGHT_ARTIFACT_DIR=.healwright
HEALWRIGHT_DEBUG=false

# --- Providers (read without the HEALWRIGHT_ prefix) ---
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=qwen/qwen3.8-27b
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_MODEL=mistral-small-2603
# Gemini: client kept, not in the default chain. Add "gemini" to
# HEALWRIGHT_PROVIDERS to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: bearer token for the triage API (needed for a non-local bind)
HEALWRIGHT_API_TOKEN=

# --- Chaos Store ---
CHAOS_CONTROL=1                      # mounts /__chaos/* control routes; never set outside tests/benchmark
