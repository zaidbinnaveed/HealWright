# Python / tooling
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets (any .env variant, e.g. a Notepad copy .env.txt; only the example is tracked)
.env
.env.*
!.env.example

# HealWright run data (baselines are committed; these are not)
.healwright/runs/
.healwright/cache/
.healwright/logs/

# Baseline store lock and temp files (baselines themselves ARE committed)
.healwright/baselines/.baselines.lock
.healwright/baselines/**/.tmp-*

# Frontend: dependencies and build output are never committed
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Fontshare fonts (ITF FFL: self-hosting allowed, redistribution not): fetched by scripts/fetch_fonts.py
frontend/public/fonts/
.healwright/demo/

# Backup demo video (about 20 MB): regenerated by scripts/record_demo.py, kept out of git
docs/presentation/*.webm

# Hosted showcase build (scripts/build_showcase.py): generated, never committed
frontend/showcase-public/
frontend/dist-showcase/
frontend/.vercel/
.vercel/
